# AKB application config — non-sensitive settings.
# Copy this file to `app.yaml` and adjust as needed.
#
# Lookup order (first hit wins): ./config/app.yaml, /etc/akb/app.yaml.

# === Database (host/port/db/user only — password is in secret.yaml) ===
db_host: postgres
db_port: 5432
db_name: akb
db_user: akb
# Main asyncpg pool sizing (optional; defaults shown). The env vars
# AKB_PG_POOL_MIN_SIZE / AKB_PG_POOL_MAX_SIZE take precedence over these
# keys — the deployment-layer knob for k8s / akb-platform.
# pg_pool_min_size: 2
# pg_pool_max_size: 30

# Runtime safety budgets. Each Kiwi child holds its own model in memory, so do
# not derive this from host CPU count. Kubernetes grants 45 seconds for pod
# termination; workers share 35 seconds and leave the remainder for teardown.
tokenizer_processes: 2
worker_shutdown_timeout_secs: 35

# === Git storage (bare repos per vault live under this path) ===
git_storage_path: /data/vaults

# === Document revision backend ===
# The stable choices are bare_git (default) and postgres_native. The Native
# choice is only valid after an operator runs `python -m app.cli
# initialize-postgres-native` against a never-used AKB database. It does not
# convert an existing Bare Git tenant. The deployment must supply a stable
# tenant/namespace identity, a provisioned database UUID, and this image's OCI
# digest. `bare_git_current` remains an alias. `native_ledger_m1` remains a
# deprecated, dedicated-database measurement alias for historical receipts.
document_revision_backend: bare_git  # bare_git | postgres_native
# document_revision_tenant_id: tenant-example
# document_revision_namespace: tenant-example
# document_revision_database_id: 11111111-1111-4111-8111-111111111111
# document_revision_runtime_image_digest: sha256:<64 lowercase hex>
native_revision_m1_measurement_only: false
# Historical M1 runs also set document_revision_backend: native_ledger_m1,
# native_revision_m1_measurement_only: true, and db_name: akb_revision_m1_measurement.

# === External-git mirror — network timeouts (seconds) ===
external_git_lsremote_timeout: 30
external_git_fetch_timeout: 300
external_git_clone_timeout: 900
external_git_claim_lookahead_secs: 3600

# === External-git mirror hardening — all optional, defaults shown ===
# external_git_enabled: true            # master kill-switch for the mirror feature
# external_git_allow_http: false        # single scheme-policy source (https always; http opt-in)
# external_git_resolver_timeout: 5.0    # hard lifetime (s) for one host resolution
# external_git_max_concurrent_resolutions: 4
# external_git_blob_max_bytes: 10485760 # per-file ceiling for a mirrored blob (10 MiB)
# external_git_poll_interval_min: 60    # code-owned floor; may be raised, never lowered below 60
# external_git_poll_interval_max: 86400
# external_git_cluster_dns_suffixes: [".svc", ".svc.cluster.local", ".cluster.local"]
# Internal-exception allowlist — each entry is a full (host, CIDR set, ports) pin.
# Empty (default) = fail-closed: every resolved mirror IP must be globally-routable unicast.
# external_git_host_allowlist:
#   - host: git.internal.example
#     cidrs: ["10.0.0.0/8"]
#     ports: [443, 8443]                # EVERY reachable port must be listed
#                                       # (the standard port is NOT auto-allowed for
#                                       # an internal-exception host); at least one required.
# Operator pod/service CIDRs — any resolved address inside one is refused BEFORE
# the allowlist, so a pod/service network can never be allow-listed by accident.
# external_git_deny_cidrs: ["10.42.0.0/16", "10.96.0.0/12"]

# === Embedding (required) ===
# Any OpenAI-compatible /v1 endpoint. Default below targets OpenAI;
# swap for OpenRouter, Ollama, vLLM, TEI, etc. — embed_dimensions must
# match the model.
embed_base_url: https://api.openai.com/v1
embed_model: text-embedding-3-small
embed_dimensions: 1536

# Standalone default keeps direct-provider routing. A managed akb-platform
# deployment sets platform_hard plus the exact gateway URL; startup then rejects
# any active embed/LLM/rerank route that points elsewhere or lacks a credential.
model_api_governance_mode: external_metering  # external_metering | platform_hard
platform_gateway_base_url: ""

# === LLM (optional) ===
# Only used by metadata_worker to auto-tag external_git imports.
# Leave empty to disable that worker; core CRUD/search keeps working.
llm_base_url: ""
llm_model: ""

# === Reranker (optional) — cross-encoder rescoring of search candidates ===
# Any endpoint that speaks the Cohere /rerank schema works
# ({model, query, documents[, top_n]} → {results: [{index, relevance_score}]}).
# `rerank_provider` is a label for logs; the dispatch is the same regardless.
#
# Tested setups:
#   1. Cohere via OpenRouter (default — multilingual incl. Korean, fast):
#        rerank_enabled: true
#        rerank_model: cohere/rerank-v3.5
#        rerank_base_url: ""   # falls back to llm_base_url
#   2. Jina hosted (multilingual, lightweight):
#        rerank_provider: jina
#        rerank_model: jina-reranker-v2-base-multilingual
#        rerank_base_url: https://api.jina.ai/v1
#        rerank_api_key: <set in secret.yaml>
#   3. On-prem open-weight (BAAI/bge-reranker-v2-m3, jina-reranker-v2,
#      etc.) behind a Cohere-compatible shim (vLLM, HF TEI, or thin
#      FastAPI wrapper):
#        rerank_provider: onprem
#        rerank_model: <model id served by your endpoint>
#        rerank_base_url: http://reranker.svc.cluster.local:8000/v1
#        rerank_api_key: ""    # leave empty if endpoint doesn't require one
rerank_enabled: false
rerank_provider: cohere
rerank_model: cohere/rerank-v3.5
# Blank → falls back to llm_base_url / llm_api_key.
rerank_base_url: ""
rerank_prefetch: 30
rerank_fusion_k: 60
rerank_timeout_seconds: 3.0
# Optional first-stage unique source pool before final response truncation.
# 0 keeps legacy behavior: only rerank-enabled searches use rerank_prefetch.
# Set >limit to give rerank-off searches more dedup headroom.
search_prefetch: 0
# Hard server-side ceiling on a search/grep `limit`. The MCP tool schema
# advertises max 50, but that is client-side only — a direct REST call or a
# non-validating client could otherwise pass an arbitrary limit that propagates
# into the vector-store prefetch (issue #189). Clamped at the service entry.
search_limit_max: 50
# Push the ACL filter down to VAULT granularity in the vector store (issue #189
# Phase 2). When true AND the driver is pgvector AND a search has no doc-level
# filter, search filters by the user's accessible vault ids (small set) instead
# of every accessible source id (O(corpus)). KEEP false until the vector index's
# vault_id column is fully backfilled — run, to completion:
#     python -m scripts.backfill_vault_id            # then --check reports 0
# Until then the column is partly NULL and the filter would silently drop those
# points. While false the behavior is identical to before.
vault_filter_enabled: false

# === S3-compatible object storage (for vault file uploads) ===
# Leave endpoints blank to disable file storage features.
s3_endpoint_url: ""        # internal endpoint (server → S3)
s3_public_url: ""          # external endpoint for presigned URLs (client → S3)
s3_bucket: akb-files
s3_region: ""

# Hidden document images follow live Markdown references. Removed/deleted
# images remain available only to matching Git revisions for this window;
# uploads that never reach a document commit expire separately.
document_asset_revision_retention_days: 30
document_asset_unclaimed_ttl_hours: 24
file_pending_upload_ttl_hours: 24
document_asset_gc_interval_secs: 300
document_asset_upload_body_timeout_secs: 60

# === Auth (system_hmac_secret is in secret.yaml) ===
# REQUIRED canonical human-login mode. Fresh runtime config never infers this
# from legacy booleans. Choose exactly one: local | sso.
# Provision the designated administrator explicitly with
# `python -m app.cli provision-recovery-admin`; ordinary registration is never admin.
auth_mode: local
# Installation-owned monotonic boundary. Keep it unchanged for an exact
# restart. Increase it for every auth_mode or sso_session_epoch transition;
# PostgreSQL rejects stale, replayed, or same-generation conflicting starts.
auth_runtime_generation: 1
# Existing installations upgrading from a pre-epoch image use this temporary
# acknowledgement only while running the documented quiescent preflight:
# sso_session_epoch_upgrade: stop-the-world-v1
jwt_algorithm: RS256
jwt_expire_hours: 24
# Generate once before the first local-mode start:
#   cd backend
#   uv run python -m app.cli generate-local-session-keyset \
#     --output-dir ../config/local-session
# The private PEM and public JWKS must survive restarts and stay outside the
# image. Replacing them without retaining the prior public JWK forces every
# local user to sign in again.
local_session_private_key_path: /etc/akb/local-session/private.pem
local_session_jwks_path: /etc/akb/local-session/jwks.json
# Blank binds both claims to public_base_url. Override only when a deployment
# needs a stable issuer/audience across an intentional public URL migration.
local_session_issuer: ""
local_session_audience: ""
publication_view_grant_ttl_secs: 600
# Rolling upgrades must keep this true until every backend instance can read
# both the two-field and bounded three-field grant formats.
publication_view_grant_emit_legacy: true
publication_view_grant_session_secs: 3600

# === App identity exchange ===
# Short-lived app tokens never carry Vaults, installations, or capabilities;
# every app request rechecks the live registry. The signing secret lives in
# secret.yaml and must differ from system_hmac_secret.
app_token_ttl_seconds: 300
app_credential_overlap_seconds: 300

# === Auth — Keycloak OIDC ===
# Human login is selected only by auth_mode. For SSO, set auth_mode: sso and
# keycloak_enabled: true. Local mode may configure Keycloak only when
# mcp_oauth_enabled: true needs it as an OAuth resource-server authority.
#
# Legacy compatibility inputs local_auth_enabled and keycloak_sso_only are
# derived from auth_mode for fresh configs. Do not set them independently;
# an explicit mismatch fails startup.
#
# Keycloak human access resolves an exact (issuer, subject) binding. The
# default `open` enrollment mode may create a brand-new AKB account and exact
# binding when email/username do not collide; it never adopts or links an
# existing account by email. Keycloak never drives AKB authorization.
# Full designs: docs/designs/keycloak-oidc/00-overview.md and
# docs/design/accepted/2026-07-10-workspace-account-governance/README.md
#
# keycloak_enabled: false
# keycloak_enrollment_mode: open           # open | invite_only | disabled
# keycloak_server_url: "https://auth.example.com"   # no /realms suffix; HTTPS outside loopback
# keycloak_internal_url: ""          # optional backchannel URL (server→Keycloak); blank → use server_url
# keycloak_backchannel_logout_uri: "" # Keycloak→AKB callback; blank → public_base_url callback.
#                                       # In Kubernetes, use the exact backend Service URL.
# keycloak_realm: "akb"
# keycloak_client_id: "akb-web"
# keycloak_public_client: false      # true → no client_secret; both profiles require PKCE
# keycloak_admin_client_id: "akb-admin"  # dedicated confidential /admin client;
#                                         # must differ from every ordinary human client
# keycloak_management_client_id: "akb-sso-manager" # standalone bundle only:
#                                         # permanent least-privilege IdP control client
# keycloak_service_admin_client_id: ""    # blank (default) → no service-account
#                                         # token authorizes anything. Naming a
#                                         # client admits its client-credentials
#                                         # service account as a NON-HUMAN AKB
#                                         # administrator, so possession of that
#                                         # client's secret becomes administrative
#                                         # authority here. It must not be an
#                                         # ordinary, companion, or /admin client.
# admin_browser_session_ttl_secs: 900     # also capped by the verified ID-token expiry
# Required for every SSO-mode start, including a staged ordinary-browser
# rollout. Generate one UUID per installation and persist it across normal
# restarts. To revoke all ordinary/admin SSO browser sessions and logout
# fences, change it and increase auth_runtime_generation in the same config
# revision. It is an authority epoch, not a credential, and may instead live
# in the durable secret.yaml operational input.
# sso_session_epoch: "<installation-owned UUID>"
# keycloak_verify_ssl: true          # false only for local self-signed Keycloak
# keycloak_require_verified_email: true   # refuse unverified email for open-mode JIT.
#                                         # Exact subject bindings need no email claim.
#                                         # Set false ONLY for a trusted realm with
#                                         # controlled emails.
# keycloak_link_by_email is a deprecated migration marker; omit it. Setting it
# to true fails canonical startup. Exact pre-binding is the only account-link path.
# Ordinary AKB browser login uses authorization code + PKCE/nonce and a fixed
# callback derived from public_base_url:
#   <public_base_url>/api/v1/auth/keycloak/callback
# The browser receives only an opaque HttpOnly AKB session handle. Refresh and
# ID tokens are encrypted server-side; access tokens are never persisted.
# Session custody remains unavailable until the independent 256-bit base64url
# `sso_browser_session_encryption_key` is present in secret.yaml.
# sso_browser_session_idle_ttl_secs: 28800      # 8 hours, sliding
# sso_browser_session_absolute_ttl_secs: 86400  # 24 hours, never extended
# sso_browser_session_refresh_skew_secs: 30
#
# `/admin` uses the separate akb-admin client. Register its exact callback as
# `<public_base_url>/api/v1/admin/auth/keycloak/callback` and post-logout
# redirect as `<public_base_url>/admin`.
#
# Companion client IDs below are accepted `azp` values for access tokens that
# Reef/Naut BFFs present to AKB. They do not select AKB's browser callback or
# receive an AKB JWT/exchange code; each companion owns its own callback and
# server-side token custody.
# keycloak_companion_client_ids_by_origin:
#   "https://reef.example.com": "reef-web"
# api_oauth_audience: ""               # default: <public_base_url>/api
# mcp_oauth_enabled: false
# mcp_oauth_audience: ""               # default: <public_base_url>/mcp
# API and MCP audiences must remain distinct.
# keycloak_client_secret, keycloak_admin_client_secret,
# sso_browser_session_encryption_key, and the optional standalone
# keycloak_management_client_secret live in secret.yaml (never commit values)

# === Server ===
host: 0.0.0.0
port: 8000

# REQUIRED. Ingress origin used to build absolute share_url values in
# publication responses (e.g. "https://akb.example.com" in prod,
# "http://localhost:8000" for docker-compose dev). Backend fails to
# start if this is empty.
public_base_url: "http://localhost:8000"

# === Vector store (driver-pluggable) ===
# Drivers:
#   qdrant   — external Qdrant container; native RRF fusion. Set
#              vector_url (and vector_api_key if your Qdrant requires
#              auth). vector_collection names the collection.
#   pgvector — PG with the pgvector extension; app-side RRF. Set
#              vector_store_dsn to a Postgres URL, or leave blank to
#              reuse the main PG pool (same-instance mode — extension
#              installs into the main PG, driver creates its own
#              `vector_index` schema so the main `chunks` table is
#              untouched).
vector_store_driver: pgvector
# vector_store_dsn: blank → reuse the main PG pool (same-instance
# mode; main DB image must have the pgvector extension installed).
# Set to a separate Postgres URL to point at a dedicated cluster.
vector_store_dsn: ""
vector_store_schema: vector_index
# Sparse-vector storage shape inside vector_index.chunks.
#   posting  — separate (term_id, chunk_id, weight) table, GIN-indexed.
#              Faster sparse queries at scale; slightly more storage.
#              Default and recommended.
#   arrays   — sparse_terms BIGINT[] + sparse_weights REAL[] columns
#              on the chunks row. Compact; slower at >100k rows.
vector_store_sparse_shape: posting

# Qdrant-driver settings (ignored when driver is pgvector).
# Set vector_url to your Qdrant endpoint (e.g. http://qdrant:6333)
# and flip vector_store_driver above to "qdrant" to enable.
vector_url: ""
vector_collection: chunks

# Seahorse Cloud driver settings (ignored unless driver is "seahorse-cloud").
# Two-plane API: management (BFF) for table lifecycle + per-table
# data-plane host (auto-discovered from BFF response).
seahorse_cloud_management_url: "https://console.seahorse.dnotitia.ai/bff"
seahorse_cloud_tenant_uuid: ""
seahorse_cloud_table_name: ""    # one of (table_name, table_uuid) required
seahorse_cloud_table_uuid: ""
seahorse_cloud_auto_create: false   # set true to provision the AKB-shaped table on first boot

# SeahorseDB self-hosted driver settings (ignored unless driver is "seahorse-db").
# Single-URL entry: the Coral coordinator. Coral routes to the
# Writer/Reader cluster + Redis + Kafka behind it — bring those up
# via SeahorseDB's deploy/docker-compose.yml (see the SeahorseDB
# monorepo's docs/integration-test for a minimal local stack).
seahorsedb_coordinator_url: "http://localhost:3003"
seahorsedb_table_name: "akb_chunks"
seahorsedb_distance: "ip"        # cosine | l2 | ip
seahorsedb_auto_create: true         # let AKB provision the table shape on first boot
seahorsedb_request_timeout_secs: 30.0

# === Indexing worker tuning ===
# Chunks claimed per worker tick. Larger = fewer round-trips to the
# embedding API but bigger transaction footprint. 16 is safe at
# OpenAI-compatible endpoint latencies; tune up to ~64 for fast
# self-hosted endpoints.
indexing_batch_size: 16
# Set indexing_concurrency: N (4-8 typical) to enable parallel embed_worker
# tasks. Default 1 stays single-task for predictable resource use; raise
# when the embedding API can absorb concurrent requests.
# indexing_concurrency: 8

# === BM25 sparse retrieval tuning (driver-neutral) ===
bm25_k1: 1.5
bm25_b: 0.75

# === Event stream (optional Redis Streams fanout) ===
# PG `events` outbox is always written. When redis_url is set the
# events_publisher worker drains the outbox to a Redis Stream so
# external consumers (other services, dashboards) can subscribe via
# XREAD / consumer groups. Leave blank to disable the worker — events
# still accumulate in PG and you can build an SSE endpoint on top of
# the LISTEN/NOTIFY trigger without Redis.
redis_url: ""              # e.g. redis://redis:6379/0
redis_event_stream: akb:events
redis_stream_maxlen: 100000

# === Audit log (compliance-grade, producer-only) ===
# AKB does NOT store/query/retain audit data — it emits an append-only,
# hash-chained JSON-lines stream and (optionally) hands the daily rolled
# file off to a WORM bucket. Your SIEM (Splunk/QRadar/Elastic/…) tails
# the file and owns retention/query under your own compliance regime.
# Local file lifecycle: today's file is appended to → a completed file is
# uploaded to the bucket the next day → the local copy is pruned
# local_retention_days after its date, but only once the upload is
# confirmed (a bucket outage accumulates files locally, never loses them).
# Omit the whole section to disable (the default).
# audit:
#   enabled: true
#   log_dir: /data/audit          # mount a PVC here in k8s (not emptyDir)
#   log_reads: true               # also log read/query calls (no bodies); writes always logged
#   bucket: ""                    # S3 bucket for daily handoff; blank → file-only. Provision with Object Lock for true WORM.
#   # Dedicated audit-storage credentials. Blank → reuse the system S3
#   # connection above (only `bucket` differs). For real segregation of
#   # duties point these at a SEPARATE account with a WRITE-ONLY key
#   # (PutObject, no Delete) — AKB never deletes bucket objects, so a
#   # compromise of the primary S3 key can't erase the audit trail.
#   endpoint_url: ""
#   access_key: ""
#   secret_key: ""
#   region: ""
#   upload_interval_secs: 3600
#   local_retention_days: 2

# === MCP tool-usage analytics ==================================
# Answers "which MCP tool is actually used, by whom, in what order, and how
# often does it fail" — questions neither of the other two streams can serve.
# `events` records domain verbs on successful writes and deletes rows once
# delivered to Redis (at least 29 of the 43 tools have no corresponding kind);
# `audit` is a tamper-evident ledger for a SIEM and is not locally groupable.
#
# One row per tool call in `tool_calls`, folded into `tool_usage_daily` (kept
# indefinitely, ~86 rows/day) and pruned after `raw_retention_days`. Budget
# roughly 250-350 bytes per call before bloat when sizing the PG volume.
#
# Off by default. Rollup/purge run even when disabled so that turning
# collection off still folds and prunes what was already gathered.
# tool_usage:
#   enabled: false
#   raw_retention_days: 30        # per-call rows; the daily rollup is kept forever
#   queue_max: 10000              # in-memory hand-off; overflow drops OLDEST and counts it
#   flush_interval_secs: 5        # idle poll only — a non-empty queue drains continuously
#   flush_batch: 500              # rows per INSERT round trip
#   rollup_interval_secs: 3600    # rollup + purge cadence
#   maintenance_batch: 5000       # rows claimed/deleted per maintenance statement
#   shutdown_deadline_secs: 8     # drain + worker stop budget; must fit the termination grace

# ── Vault skill auto-injection ────────────────────────────────
# The first tool call a session makes against a vault gets that vault's
# `overview/vault-skill.md` attached to the response under `vault_skill`, so an
# agent picks up the vault's conventions without being told to go read them.
# Re-attached only when the doc changes; mirror (external-git) vaults are
# excluded, because auto-injecting upstream-controlled markdown into every
# session would be an instruction-injection vector.
#
# On by default. `enabled: false` is the operator kill switch — it stops the
# automatic channel only; akb_help(topic="vault-skill") still serves the doc.
# vault_skill:
#   enabled: true
#   body_max_bytes: 16384         # injected body ceiling; past this it is clipped with truncated=true
#   cache_ttl_secs: 60            # per-vault version/body cache; write-through invalidation covers one replica
#   session_map_max: 10000        # bound on the (session, vault) tracking map; eviction just re-injects once
#   vault_cache_max: 4096         # LRU bound on the per-vault cache; the TTL governs freshness, not size
#   fetch_timeout_secs: 3.0       # ceiling on one cache-miss lookup; on timeout the call ships without a payload

# ── Tenant stats listener (`/stats`) ──────────────────────────
# A cached inventory snapshot — storage bytes, corpus counts, and the previous
# complete UTC day's call volume — served as plain JSON on a SEPARATE port.
#
# The port is separate because the caller (a control plane's monitor) must be
# able to read inventory without being able to reach tenant data, and the only
# enforcement layer for that is a NetworkPolicy, which selects on port. For the
# same reason the surface carries no authentication of its own: reachability is
# the authorization, so DO NOT bind this port on a deployment whose network
# policy does not restrict who may connect to it.
#
# Off by default — leave `port` unset and no socket is bound and no sampler
# runs. `AKB_STATS_PORT` overrides `port` (the deployment-layer exception, same
# class as AKB_PG_POOL_MIN_SIZE/MAX_SIZE).
#
# Requests are served from the last sample and never recompute, so polling is
# free; poll at half the sampler interval or faster, otherwise a phase drift
# skips whole snapshots. Not a metrics endpoint: no Prometheus dependency, no
# exposition format.
# stats:
#   port: 9105                    # unset = the listener is not composed at all; 9105 is the akb-platform default (its tenant-monitor and NetworkPolicy render the same number)
#   host: "0.0.0.0"               # the NetworkPolicy, not the bind address, is what makes this safe
#   sampler_interval_secs: 300    # the only thing that decides what this surface costs
#   activity_grace_minutes: 5     # settling time after a UTC day closes, before its volume is folded (permanently)

{
  "name": "@akb/client",
  "version": "0.1.0",
  "description": "Reference AKB REST client boundary for kind envelopes and {data,error} results.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "akb": "./bin/akb.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./lite": {
      "types": "./src/lite.d.ts",
      "import": "./src/lite.js"
    }
  },
  "files": [
    "bin/",
    "README.md",
    "scripts/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "codegen:check": "node scripts/check-generated-types.mjs && node scripts/check-core-types.mjs",
    "codegen:core:check": "node scripts/check-core-types.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnotitia/akb.git",
    "directory": "packages/akb-client"
  }
}

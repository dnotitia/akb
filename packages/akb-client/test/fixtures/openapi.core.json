              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityFileChange": {
        "type": "object",
        "required": ["path", "change"],
        "properties": {
          "path": { "type": "string" },
          "change": { "type": "string", "enum": ["added", "deleted", "modified"] }
        },
        "additionalProperties": { "$ref": "#/components/schemas/AkbJsonValue" }
      },
      "ActivityEntry": {
        "type": "object",
        "required": ["hash", "subject", "author", "date", "action", "summary", "agent", "files"],
        "properties": {
          "hash": { "type": "string" },
          "subject": { "type": "string" },
          "author": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "action": { "type": "string" },
          "summary": { "type": "string" },
          "agent": { "type": "string" },
          "files": { "type": "array", "items": { "$ref": "#/components/schemas/ActivityFileChange" } },
          "author_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "additionalProperties": { "$ref": "#/components/schemas/AkbJsonValue" }
      },
      "RecentDocumentChange": {
        "type": "object",
        "required": ["doc_id", "vault", "path", "title", "type", "commit", "changed_at"],
        "properties": {
          "doc_id": { "type": "string" },
          "vault": { "type": "string" },
          "path": { "type": "string" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "commit": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "changed_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
        },
        "additionalProperties": { "$ref": "#/components/schemas/AkbJsonValue" }
      },
      "DocumentHistoryEntry": {
        "type": "object",
        "required": ["hash", "message", "author", "date"],
        "properties": {
          "hash": { "type": "string" },
          "message": { "type": "string" },
          "author": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "author_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "additionalProperties": { "$ref": "#/components/schemas/AkbJsonValue" }
      },
      "AkbActivityEnvelope": {
        "type": "object",
        "required": ["kind", "vault", "total", "activity"],
        "properties": {
          "kind": { "type": "string", "const": "activity" },
          "vault": { "type": "string" },
          "total": { "type": "integer" },
          "activity": { "type": "array", "items": { "$ref": "#/components/schemas/ActivityEntry" } }
        }
      },
      "AkbRecentChangesEnvelope": {
        "type": "object",
        "required": ["kind", "changes"],
        "properties": {
          "kind": { "type": "string", "const": "recent_changes" },
          "changes": { "type": "array", "items": { "$ref": "#/components/schemas/RecentDocumentChange" } }
        }
      },
      "AkbDocumentHistoryEnvelope": {
        "type": "object",
        "required": ["kind", "uri", "history"],
        "properties": {
          "kind": { "type": "string", "const": "document_history" },
          "uri": { "type": "string" },
          "history": { "type": "array", "items": { "$ref": "#/components/schemas/DocumentHistoryEntry" } }
        }
      },
      "AkbDocumentDiffEnvelope": {
        "type": "object",
        "required": ["kind", "file", "commit", "type", "diff"],
        "properties": {
          "kind": { "type": "string", "const": "document_diff" },
          "file": { "type": "string" },
          "commit": { "type": "string" },
          "type": { "type": "string", "enum": ["added", "deleted", "modified", "unknown", "unchanged"] },
          "diff": { "type": "string" },
          "error": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        }
      },
      "AkbDocumentEnvelope": {},
      "AkbDocumentWriteEnvelope": {},
      "AkbDrillDownEnvelope": {},
      "AkbError": {},
      "AkbFileEnvelope": {},
      "AkbGrepEnvelope": {},
      "AkbGraphNode": {
        "type": "object",
        "required": ["uri", "name", "resource_type"],
        "properties": {
          "uri": { "type": "string" },
          "name": { "type": "string" },
          "resource_type": { "type": "string", "enum": ["doc", "table", "file"] },
          "depth": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
          "degree": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }
        },
        "additionalProperties": { "$ref": "#/components/schemas/AkbJsonValue" }
      },
      "AkbGraphEdge": {
        "type": "object",
        "required": ["source", "target", "relation", "kind"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": { "type": "string", "enum": ["depends_on", "related_to", "implements", "references", "attached_to", "derived_from", "links_to"] },
          "kind": { "type": "string", "enum": ["implicit", "explicit"] }
        },
        "additionalProperties": { "$ref": "#/components/schemas/AkbJsonValue" }
      },
      "AkbGraphEnvelope": {
        "oneOf": [
          { "$ref": "#/components/schemas/AkbGraphNeighborsEnvelope" },
          { "$ref": "#/components/schemas/AkbGraphOverviewEnvelope" }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "graph_neighbors": "#/components/schemas/AkbGraphNeighborsEnvelope",
            "graph_overview": "#/components/schemas/AkbGraphOverviewEnvelope"
          }
        }
      },
      "AkbGraphNeighborsEnvelope": {
        "type": "object",
        "required": ["kind", "nodes", "edges"],
        "properties": {
          "kind": { "type": "string", "const": "graph_neighbors" },
          "nodes": { "type": "array", "items": { "$ref": "#/components/schemas/AkbGraphNode" } },
          "edges": { "type": "array", "items": { "$ref": "#/components/schemas/AkbGraphEdge" } }
        }
      },
      "AkbGraphOverviewEnvelope": {
        "type": "object",
        "required": ["kind", "nodes", "edges", "nodes_total", "edges_total", "returned", "truncated", "orphans_returned", "orphans_truncated"],
        "properties": {
          "kind": { "type": "string", "const": "graph_overview" },
          "nodes": { "type": "array", "items": { "$ref": "#/components/schemas/AkbGraphNode" } },
          "edges": { "type": "array", "items": { "$ref": "#/components/schemas/AkbGraphEdge" } },
          "nodes_total": { "type": "integer" },
          "edges_total": { "type": "integer" },
          "returned": { "type": "integer" },
          "truncated": { "type": "boolean" },
          "orphans_returned": { "type": "integer" },
          "orphans_truncated": { "type": "boolean" }
        }
      },
      "AkbGraphHealthEnvelope": {
        "type": "object",
        "required": ["kind", "hubs", "orphans"],
        "properties": {
          "kind": { "type": "string", "const": "graph_health" },
          "hubs": { "type": "array", "items": { "$ref": "#/components/schemas/AkbGraphNode" } },
          "orphans": {
            "type": "object",
            "required": ["count", "sample"],
            "properties": {
              "count": { "type": "integer" },
              "sample": { "type": "array", "items": { "$ref": "#/components/schemas/AkbGraphNode" } }
            }
          }
        }
      },
      "AkbRelation": {
        "type": "object",
        "required": ["direction", "relation", "uri", "resource_type"],
        "properties": {
          "direction": { "type": "string", "enum": ["incoming", "outgoing"] },
          "relation": { "type": "string", "enum": ["depends_on", "related_to", "implements", "references", "attached_to", "derived_from", "links_to"] },
          "uri": { "type": "string" },
          "resource_type": { "type": "string", "enum": ["doc", "table", "file"] },
          "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "additionalProperties": { "$ref": "#/components/schemas/AkbJsonValue" }
      },
      "AkbRelationsEnvelope": {
        "type": "object",
        "required": ["kind", "uri", "relations"],
        "properties": {
          "kind": { "type": "string", "const": "relations" },
          "uri": { "type": "string" },
          "relations": { "type": "array", "items": { "$ref": "#/components/schemas/AkbRelation" } }
        }
      },
      "AkbRelationLinkEnvelope": {
        "type": "object",
        "required": ["kind", "linked", "source", "target", "relation"],
        "properties": {
          "kind": { "type": "string", "const": "relation_link" },
          "linked": { "type": "boolean" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": { "type": "string", "enum": ["depends_on", "related_to", "implements", "references", "attached_to", "derived_from"] }
        }
      },
      "AkbRelationUnlinkEnvelope": {
        "type": "object",
        "required": ["kind", "unlinked", "source", "target"],
        "properties": {
          "kind": { "type": "string", "const": "relation_unlink" },
          "unlinked": { "type": "integer" },
          "source": { "type": "string" },
          "target": { "type": "string" }
        }
      },
      "AkbProvenanceEnvelope": {
        "type": "object",
        "required": ["kind", "doc_id", "title", "path", "vault", "uri", "created_by", "created_at", "updated_at", "current_commit", "relations"],
        "properties": {
          "kind": { "type": "string", "const": "provenance" },
          "doc_id": { "type": "string" },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "vault": { "type": "string" },
          "uri": { "type": "string" },
          "created_by": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "created_at": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "updated_at": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "current_commit": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "relations": { "type": "array", "items": { "$ref": "#/components/schemas/AkbRelation" } }
        }
      },
      "AkbSearchEnvelope": {},
      "AkbSqlEnvelope": {},
      "AkbTableEnvelope": {},
      "AkbTableMigrationEnvelope": {},
      "AkbTableQueryEnvelope": {},
      "AkbTableSchemaEnvelope": {},
      "AkbTableSqlEnvelope": {},
      "AkbVaultTableSchemaEnvelope": {}
    }
  }
}

{
  "name": "@akb/markdown-editor",
  "version": "0.1.0",
  "description": "Product-neutral Tiptap Markdown editor, viewer, and conformance contract for AKB and Reef.",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage .vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts test vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:consumer": "node scripts/test-packed-consumer.mjs",
    "pack:check": "pnpm run build && pnpm pack --pack-destination .artifacts",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-mathematics": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "katex": "0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.3",
    "vitest": "4.1.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnotitia/akb.git",
    "directory": "packages/markdown-editor"
  }
}

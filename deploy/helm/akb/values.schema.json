{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profile", "global", "images", "secretContract", "sso"],
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["standalone", "standalone-sso"]
    },
    "global": {
      "type": "object",
      "required": ["publicUrl"],
      "properties": {
        "publicUrl": {"type": "string", "pattern": "^https?://[^/]+/?$"}
      }
    },
    "images": {
      "type": "object",
      "required": ["backend", "frontend"],
      "properties": {
        "backend": {"$ref": "#/$defs/image"},
        "frontend": {"$ref": "#/$defs/image"}
      }
    },
    "secretContract": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
      }
    },
    "sso": {
      "type": "object",
      "required": ["enabled", "keycloakPublicUrl", "productAdmin"],
      "properties": {
        "enabled": {"type": "boolean"},
        "keycloakPublicUrl": {"type": "string", "pattern": "^https?://[^/]+/?$"},
        "companionClientIdsByOrigin": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "companionLoginClients": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["provider_aliases", "public_keys"],
            "additionalProperties": false,
            "properties": {
              "provider_aliases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"}
              },
              "public_keys": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 8,
                "propertyNames": {"pattern": "^[A-Za-z0-9_-]{1,128}$"},
                "additionalProperties": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "productAdmin": {
          "type": "object",
          "required": ["username", "email"],
          "properties": {
            "username": {"type": "string", "minLength": 1},
            "email": {"type": "string", "minLength": 3}
          }
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profile", "global", "images", "secretContract", "sso"],
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["standalone", "standalone-sso"]
    },
    "global": {
      "type": "object",
      "required": ["publicUrl"],
      "properties": {
        "publicUrl": {"type": "string", "pattern": "^https?://[^/]+/?$"}
      }
    },
    "images": {
      "type": "object",
      "required": ["backend", "frontend"],
      "properties": {
        "backend": {"$ref": "#/$defs/image"},
        "frontend": {"$ref": "#/$defs/image"}
      }
    },
    "secretContract": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "vectorStore": {
          "type": "object",
          "properties": {
            "startupPrewarm": {
              "type": "string",
              "enum": ["off", "index", "search"]
            }
          }
        },
        "bm25": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hybridMaxDfRatio"],
          "properties": {
            "hybridMaxDfRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "properties": {
            "autoPrewarm": {"type": "boolean"}
          }
        }
      }
    },
    "sso": {
      "type": "object",
      "required": ["enabled", "keycloakPublicUrl", "productAdmin"],
      "properties": {
        "enabled": {"type": "boolean"},
        "keycloakPublicUrl": {"type": "string", "pattern": "^https?://[^/]+/?$"},
        "productAdmin": {
          "type": "object",
          "required": ["username", "email"],
          "properties": {
            "username": {"type": "string", "minLength": 1},
            "email": {"type": "string", "minLength": 3}
          }
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}

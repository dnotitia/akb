+/// Reads a growing segment's documents in order and keeps its place, so a later
+/// call reads only the documents appended since.
+pub struct GrowingSegmentTail {
+    doc_id: u32,
+    blkno: pgrx::pg_sys::BlockNumber,
+    offset: pgrx::pg_sys::OffsetNumber,
+    redirect_data: Vec<u8>,
+}
+
+impl GrowingSegmentTail {
+    /// Starts at `doc_id`, the metapage's `sealed_doc_id`.
+    pub fn new(doc_id: u32) -> Self {
+        Self {
+            doc_id,
+            blkno: pgrx::pg_sys::InvalidBlockNumber,
+            offset: 1,
+            redirect_data: Vec::new(),
+        }
+    }
+
+    /// Calls `f` for each document from where the last call stopped up to
+    /// `doc_id_end`. The caller read `segment` and `doc_id_end` from the
+    /// metapage and keeps the segment from being sealed meanwhile.
+    pub fn read_until(
+        &mut self,
+        index: pgrx::pg_sys::Relation,
+        segment: Option<&GrowingSegmentData>,
+        doc_id_end: u32,
+        mut f: impl FnMut(u32, Bm25VectorBorrowed<'_>),
+    ) {
+        if self.doc_id >= doc_id_end {
+            return;
+        }
+        if self.blkno == pgrx::pg_sys::InvalidBlockNumber {
+            self.blkno = segment.expect("documents without a growing segment").first_blkno.get();
+        }
+        loop {
+            let page = page_read(index, self.blkno);
+            let count = page_get_max_offset_number(&page);
+            while self.offset <= count {
+                if self.doc_id >= doc_id_end {
+                    return;
+                }
+                let item_id = page_get_item_id(&page, self.offset);
+                if item_id.lp_flags() == pgrx::pg_sys::LP_REDIRECT {
+                    self.redirect_data.clear();
+                    let first_blkno: &u32 = page_get_item(&page, item_id);
+                    let mut reader = PageReader::new(index, *first_blkno);
+                    reader.read_to_end(&mut self.redirect_data).unwrap();
+                    let item: &Bm25VectorHeader = unsafe { &*self.redirect_data.as_ptr().cast() };
+                    f(self.doc_id, item.borrow());
+                } else {
+                    let item: &Bm25VectorHeader = page_get_item(&page, item_id);
+                    f(self.doc_id, item.borrow());
+                }
+                self.offset += 1;
+                self.doc_id += 1;
+            }
+            if self.doc_id >= doc_id_end {
+                return;
+            }
+            self.blkno = page.opaque.next_blkno;
+            assert!(self.blkno != pgrx::pg_sys::InvalidBlockNumber, "growing segment ends early");
+            self.offset = 1;
+        }
+    }
+}

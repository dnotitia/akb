--- a/src/segment/meta.rs
+++ b/src/segment/meta.rs
@@ -1,6 +1,11 @@
 use super::{growing::GrowingSegmentData, sealed::SealedSegmentData};
 
 pub const META_VERSION: u32 = 1;
+// The high bit of `version` records that a bulk delete took documents off the
+// counts and no recount of the term statistics has finished since. Nothing
+// reads the version, so the flag leaves the page format as it is, and an index
+// built before it reads as owing nothing.
+const RECOUNT_OWED: u32 = 1 << 31;
 
 #[derive(Debug)]
 pub struct MetaPageData {
@@ -44,4 +49,16 @@ impl MetaPageData {
     pub fn avgdl(&self) -> f32 {
         self.doc_term_cnt as f32 / self.doc_cnt as f32
     }
+
+    pub fn recount_owed(&self) -> bool {
+        self.version & RECOUNT_OWED != 0
+    }
+
+    pub fn set_recount_owed(&mut self, owed: bool) {
+        if owed {
+            self.version |= RECOUNT_OWED;
+        } else {
+            self.version &= !RECOUNT_OWED;
+        }
+    }
 }

+// Two pages changed under one WAL record: recovery replays both changes or
+// neither.
+pub struct PagePairWriteGuard {
+    bufs: [i32; 2],
+    pages: [NonNull<PageData>; 2],
+    state: *mut pgrx::pg_sys::GenericXLogState,
+}
+
+impl PagePairWriteGuard {
+    pub fn pages_mut(&mut self) -> (&mut PageData, &mut PageData) {
+        unsafe { (self.pages[0].as_mut(), self.pages[1].as_mut()) }
+    }
+}
+
+impl Drop for PagePairWriteGuard {
+    fn drop(&mut self) {
+        unsafe {
+            if std::thread::panicking() {
+                pgrx::pg_sys::GenericXLogAbort(self.state);
+            } else {
+                pgrx::pg_sys::GenericXLogFinish(self.state);
+            }
+            pgrx::pg_sys::UnlockReleaseBuffer(self.bufs[1]);
+            pgrx::pg_sys::UnlockReleaseBuffer(self.bufs[0]);
+        }
+    }
+}
+
+// Locks `first` before `second`. Pass the metapage first, the order every
+// other path takes it in.
+pub fn page_write_pair(
+    relation: pgrx::pg_sys::Relation,
+    first: pgrx::pg_sys::BlockNumber,
+    second: pgrx::pg_sys::BlockNumber,
+) -> PagePairWriteGuard {
+    assert!(first != pgrx::pg_sys::InvalidBlockNumber);
+    assert!(second != pgrx::pg_sys::InvalidBlockNumber);
+    assert!(first != second);
+    unsafe {
+        use pgrx::pg_sys::{
+            ForkNumber, GenericXLogRegisterBuffer, GenericXLogStart, LockBuffer,
+            ReadBufferExtended, ReadBufferMode, BUFFER_LOCK_EXCLUSIVE,
+        };
+        // Pin both before locking either, so no read waits under the first lock.
+        let bufs = [first, second].map(|blkno| {
+            ReadBufferExtended(
+                relation,
+                ForkNumber::MAIN_FORKNUM,
+                blkno,
+                ReadBufferMode::RBM_NORMAL,
+                std::ptr::null_mut(),
+            )
+        });
+        LockBuffer(bufs[0], BUFFER_LOCK_EXCLUSIVE as _);
+        LockBuffer(bufs[1], BUFFER_LOCK_EXCLUSIVE as _);
+        let state = GenericXLogStart(relation);
+        let pages = bufs.map(|buf| {
+            let page = GenericXLogRegisterBuffer(state, buf, 0);
+            NonNull::new(page.cast()).expect("failed to get page")
+        });
+        PagePairWriteGuard { bufs, pages, state }
+    }
+}
+

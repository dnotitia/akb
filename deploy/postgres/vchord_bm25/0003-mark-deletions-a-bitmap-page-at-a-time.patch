+
+    /// The block of the page that holds `doc_id`'s bit.
+    pub fn blkno(&self, doc_id: u32) -> pgrx::pg_sys::BlockNumber {
+        self.0.get_block_id(doc_id / DELETE_BITMAP_PAGE_DOCS)
+    }
+}
+
+/// Sets `doc_id`'s bit on `page`, the page `DeleteBitmapReader::blkno` names for
+/// it. Returns whether the bit was clear, so a caller counts a document out once.
+pub fn mark_deleted(page: &mut PageData, doc_id: u32) -> bool {
+    let byte = &mut page.data_mut()[(doc_id % DELETE_BITMAP_PAGE_DOCS / 8) as usize];
+    let bit = 1 << (doc_id % 8);
+    let was_clear = *byte & bit == 0;
+    *byte |= bit;
+    was_clear
 }
 

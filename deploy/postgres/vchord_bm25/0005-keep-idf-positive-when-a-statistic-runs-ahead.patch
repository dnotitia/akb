---
diff --git a/src/weight.rs b/src/weight.rs
index d2f243a..156142f 100644
--- a/src/weight.rs
+++ b/src/weight.rs
@@ -32,9 +32,17 @@ impl Bm25Weight {
 }
 
 // ln ( (N + 1) / (n(q) + 0.5) )
+//
+// A term's document count never exceeds N once the index is settled, but it
+// runs ahead of N until the recount a bulk delete owes has finished: the bulk
+// delete takes its documents off N at once and off each term's count only in
+// the recount. Held at N, the count gives the smallest IDF the formula has,
+// ln(1 + 0.5 / (N + 0.5)), which is positive. The ratio is taken in f64: in f32
+// it rounds to exactly 1, an IDF of 0, once N passes about 8.4 million.
 #[inline]
 pub fn idf(doc_cnt: u32, doc_freq: u32) -> f32 {
-    (((doc_cnt + 1) as f32) / (doc_freq as f32 + 0.5)).ln()
+    let doc_freq = doc_freq.min(doc_cnt);
+    ((f64::from(doc_cnt) + 1.0) / (f64::from(doc_freq) + 0.5)).ln() as f32
 }
 
 pub fn bm25_score_batch(

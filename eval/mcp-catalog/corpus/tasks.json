    {
      "pair_id": "table-publication",
      "common": {
        "suite": "capability",
        "category": "multi_step",
        "capability_families": ["table_lifecycle", "publication_lifecycle"],
        "user_outcome": "Create and query a table, publish the bounded query, list it, and remove the share.",
        "accepted_behaviors": [{"id": "table-query-share", "description": "The table and publication are confirmed by public outcomes and the share is removed by its returned identifier.", "mode": "complete", "required_operations": ["create", "search", "list", "delete"], "required_resources": ["table", "publication"]}],
        "allowed_resources": ["vault", "table", "publication", "identity"],
        "coverage_tools": ["akb_create_table", "akb_sql", "akb_alter_table", "akb_drop_table", "akb_publish", "akb_publications", "akb_publication_snapshot", "akb_unpublish"],
        "fixture": {"scenario": "app-control-plane", "credential_profile": "default", "transports": ["http", "stdio"]},
    "allowed_preparatory_operations": ["identity"],
        "allowed_material_operations": ["create", "search", "list", "delete"],
        "allowed_first_operations": ["create"],
        "forbidden_operations": ["grant"],
        "forbidden_mutations": [{"operation": "delete", "target_contains": "catalog-bench-data", "reason": "The vault must remain."}],
        "required_attempted_operations": ["create", "search", "list", "delete"],
        "material_attempt_limits": {"create": 3, "search": 1, "list": 1, "delete": 1},
        "material_attempt_minimums": {"create": 3, "search": 1, "list": 1, "delete": 1},
        "required_operations": ["create", "search", "list", "delete"],
        "expected_material_outcomes": [{"logical_operation": "create", "outcome": "success"}, {"logical_operation": "search", "outcome": "success"}, {"logical_operation": "list", "outcome": "success"}, {"logical_operation": "delete", "outcome": "success"}],
        "expected_material_attempts": [
          {"logical_operation": "create", "resource_type": "vault", "arguments": {"name": "catalog-bench-data"}, "outcome": "success"},
          {"logical_operation": "create", "resource_type": "table", "arguments": {"vault": "catalog-bench-data", "name": "scores", "columns": [{"name": "label", "type": "text"}]}, "outcome": "success"},
          {"logical_operation": "search", "resource_type": "table", "arguments": {"vault": "catalog-bench-data", "sql": "SELECT * FROM scores LIMIT 5"}, "outcome": "success"},
          {"logical_operation": "create", "resource_type": "publication", "arguments": {"resource_type": "table_query", "vault": "catalog-bench-data", "query_sql": "SELECT * FROM scores LIMIT 5"}, "outcome": "success"},
          {"logical_operation": "list", "resource_type": "publication", "arguments": {"vault": "catalog-bench-data"}, "outcome": "success"},
          {"logical_operation": "delete", "resource_type": "publication", "arguments": {}, "outcome": "success"}
        ],
        "expected_result_bindings": [{"source_attempt": 4, "source_field": "slug", "target_attempt": 6, "target_argument": "slug", "relation": "equals"}],
        "expected_final_state": {"probe": {"service": "app", "method": "GET", "path": "/api/v1/browse/catalog-bench-data?depth=-1"}, "must": [{"pointer": "/items", "operator": "contains", "value": {"name": "scores"}}]}
      },
      "locales": {
        "ko-KR": {"id": "table-publication-ko", "prompt": "`catalog-bench-data` 보관함과 텍스트 열 `label`이 있는 `scores` 표를 만들어 줘. `SELECT * FROM scores LIMIT 5`를 실행하고 같은 제한 쿼리를 공개한 뒤 공개 목록에서 확인해. 마지막에는 반환된 공개 식별자로 공유만 해제하고 표와 보관함은 남겨 둬.", "response_rubric": {"require_non_empty": true, "success_claim_terms": ["성공", "완료", "해제"]}},
        "en-US": {"id": "table-publication-en", "prompt": "Create `catalog-bench-data` and a `scores` table with text column `label`. Run `SELECT * FROM scores LIMIT 5`, publish that same bounded query, and confirm it in the publication list. Finally remove only the share by its returned identifier and leave the table and vault intact.", "response_rubric": {"require_non_empty": true, "success_claim_terms": ["success", "complete", "removed"]}}
      }

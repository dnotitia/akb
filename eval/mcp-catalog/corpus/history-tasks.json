          {
            "logical_operation": "image_upload",
            "outcome": "success"
          },
          {
            "logical_operation": "create",
            "outcome": "success"
          }
        ],
        "expected_material_attempts": [
          {
            "logical_operation": "file_upload",
            "resource_type": "file",
            "arguments": {
              "vault": "catalog-bench-vault-authorization",
              "collection": ""
            },
            "local_file_arguments": {
              "file_path": "sample-note.txt"
            },
            "outcome": "success",
            "stage_id": "file_upload_file_1"
          },
          {
            "logical_operation": "image_upload",
            "resource_type": "image",
            "arguments": {
              "vault": "catalog-bench-vault-authorization",
              "alt_text": "benchmark sample image"
            },
            "local_file_arguments": {
              "file_path": "sample-image.png"
            },
            "outcome": "success",
            "stage_id": "image_upload_image_1"
          },
          {
            "logical_operation": "create",
            "resource_type": "document",
            "arguments": {
              "vault": "catalog-bench-vault-authorization",
              "title": "catalog-bench-stdio-document"
            },
            "outcome": "success",
            "stage_id": "create_document_1"
          }
        ],
        "expected_result_bindings": [
          {
            "source_field": "markdown",
            "target_argument": "content",
            "relation": "contains",
            "source_stage": "image_upload_image_1",
            "target_stage": "create_document_1"
          }
        ],
        "expected_final_state": {
          "probe": {
            "service": "app",
            "method": "GET",
            "path": "/api/v1/browse/catalog-bench-vault-authorization?depth=0"
          },
          "must": [
            {
              "pointer": "/items",
              "operator": "contains",
              "value": [
                {
                  "name": "sample-note.txt",
                  "type": "file"
                },
                {
                  "name": "catalog-bench-stdio-document",
                  "type": "document"
                }
              ]
            }
          ]
        }
      },
      "locales": {
        "ko-KR": {
          "id": "stdio-local-ko",
          "prompt": "기존 `catalog-bench-vault-authorization` 루트에 `sample-note.txt`를 파일로 올려. 이어 `sample-image.png`를 대체 텍스트 `benchmark sample image`로 준비하고, 반환된 Markdown을 그대로 포함하는 `catalog-bench-stdio-document`를 같은 루트에 만들어. 문서 생성이 실패하면 미사용 이미지를 정리해.",
          "response_rubric": {
            "require_non_empty": true,
            "success_claim_terms": [
              "성공",
              "완료",
              "생성"
            ]
          }
        },
        "en-US": {
          "id": "stdio-local-en",
          "prompt": "Upload `sample-note.txt` as a root file in existing `catalog-bench-vault-authorization`. Then prepare `sample-image.png` with alt text `benchmark sample image` and create `catalog-bench-stdio-document` at the same root with the returned Markdown included verbatim. Clean up an unused image if document creation fails.",
          "response_rubric": {
            "require_non_empty": true,
            "success_claim_terms": [
              "success",
              "complete",
              "created"
            ]
          }
        }
      }
